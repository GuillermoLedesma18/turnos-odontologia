# ==============================================================================
# Plantilla de configuración. Copiar a .env y completar.
# `.env` está ignorado por git; este archivo sí se versiona.
# Las variables sin valor productivo alcanzan para levantar el proyecto en local.
# ==============================================================================

# --- Aplicación: requeridas ---------------------------------------------------
# Única variable requerida en la fundación. Formato: postgresql://usuario:clave@host:puerto/base
DATABASE_URL="postgresql://turnos:turnos@localhost:5432/turnos"

# --- Aplicación: opcionales ---------------------------------------------------
# Opcional = puede faltar, pero si está presente su formato debe ser válido.
# Pasan a requeridas cuando entra en vigor la funcionalidad que las usa.
# Reemplazar los placeholders de desarrollo antes de cualquier despliegue.

# Sesión del odontólogo (C-03). Mínimo 32 caracteres.
SESSION_SECRET="dev-only-placeholder-cambiar-antes-de-desplegar"
# Generación de enlaces del turno (C-08).
APP_BASE_URL="http://localhost:3000"
# Zona horaria del consultorio, formato IANA (C-05).
TZ_CONSULTORIO="America/Argentina/Buenos_Aires"

# WhatsApp Business Cloud API (C-13).
WHATSAPP_TOKEN="dev-placeholder"
WHATSAPP_PHONE_ID="dev-placeholder"
WHATSAPP_VERIFY_TOKEN="dev-placeholder"
WHATSAPP_APP_SECRET="dev-placeholder"

# Proveedor de email de respaldo (C-14).
EMAIL_API_KEY="dev-placeholder"
EMAIL_FROM="turnos@example.com"

# Job de auto-liberación (C-15).
CRON_SECRET="dev-placeholder"

# --- Infraestructura local ----------------------------------------------------
# Credenciales del contenedor de Postgres que levanta `npm run db:up`.
# NO son configuración de la aplicación: no las valida `src/lib/env.ts`.
# Deben ser consistentes con el usuario y la base de DATABASE_URL.
POSTGRES_USER="turnos"
POSTGRES_PASSWORD="turnos"
POSTGRES_DB="turnos"
